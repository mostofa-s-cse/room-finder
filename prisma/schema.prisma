generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url=env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  passwordHash            String
  role                    UserRole                 @default(BACHELOR)
  status                  String                   @default("ACTIVE")
  emailVerifiedAt         DateTime?
  verificationTokens      EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  profilePicture          String?
  income                  Float?
  affordablePrice         Float?
  transportMode           TransportMode?
  lastLogin               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  adminLogs               AdminLog[]               @relation("AdminLogs")
  analyticsAlerts         AnalyticsAlert[]         @relation("UserAlerts")
  analyticsInsights       AnalyticsInsight[]       @relation("UserInsights")
  blockedByUsers          BlockedUser[]            @relation("UserBlockedBy")
  blockedUsers            BlockedUser[]            @relation("UserBlocked")
  payments                BookingPayment[]         @relation("UserPayments")
  bookings                Booking[]
  chatAnalytics           ChatAnalytics[]          @relation("UserChatAnalytics")
  chatParticipants        ChatParticipant[]        @relation("UserChatParticipants")
  chatReports             ChatReport[]             @relation("UserChatReports")
  chatSettings            ChatSettings?            @relation("UserChatSettings")
  favorites               UserFavorite[]           @relation("UserFavorites")
  invoices                Invoice[]                @relation("UserInvoices")
  landlordAnalytics       LandlordAnalytics[]      @relation("LandlordAnalyticsData")
  listings                Listing[]
  notificationPreferences NotificationPreferences? @relation("UserNotificationPreferences")
  notifications           NotificationModel[]      @relation("UserNotifications")
  paymentIntents          PaymentIntent[]          @relation("UserPaymentIntents")
  paymentMethods          PaymentMethod[]          @relation("UserPaymentMethods")
  pushSubscriptions       PushSubscription[]       @relation("UserPushSubscriptions")
  reports                 Report[]
  reviews                 Review[]
  savedSearches           SavedSearch[]            @relation("UserSavedSearches")
  searchAnalytics         SearchAnalytics[]        @relation("UserSearchAnalytics")
  subscriptions           Subscription[]           @relation("UserSubscriptions")
  transactions            Transaction[]            @relation("UserTransactions")
  userActions             UserAction[]             @relation("UserActionHistory")
  userAnalytics           UserAnalytics[]          @relation("UserAnalyticsData")
  bachelorRequests        TenantRequest[]          @relation("BachelorRequests")
  landlordRequests        TenantRequest[]          @relation("LandlordRequests")
  monthlyPayments         MonthlyPayment[]         @relation("UserMonthlyPayments")

  @@map("users")
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  code       String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Listing {
  id                String             @id @default(cuid())
  landlordId        String
  title             String
  description       String
  price             Float
  monthlyRent       Float?
  city              String
  address           String
  location          String?
  lat               Float?
  lng               Float?
  roomType          RoomType           @default(SINGLE)
  amenities         Json             @default("[]")
  images            Json             @default("[]")
  averageRating     Float              @default(0)
  ratingAvg         Float              @default(0)
  ratingCount       Int                @default(0)
  status            String             @default("PENDING")
  isPublished       Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  availableFrom     DateTime?
  contactEmail      String?
  contactPhone      String?
  rules             Json             @default("[]")
  analyticsAlerts   AnalyticsAlert[]   @relation("ListingAlerts")
  analyticsInsights AnalyticsInsight[] @relation("ListingInsights")
  payments          BookingPayment[]   @relation("ListingPayments")
  bookings          Booking[]
  chatThreads       ChatThread[]       @relation("ThreadListing")
  favoritedBy       UserFavorite[]     @relation("ListingFavorites")
  listingAnalytics  ListingAnalytics?  @relation("ListingAnalyticsData")
  landlord          User               @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  paymentIntents    PaymentIntent[]    @relation("ListingPaymentIntents")
  reports           Report[]
  reviews           Review[]
  transactions      Transaction[]      @relation("ListingTransactions")
  tenantRequests    TenantRequest[]    @relation("ListingRequests")
  monthlyPayments   MonthlyPayment[]   @relation("ListingMonthlyPayments")

  @@index([landlordId], map: "listings_landlordId_fkey")
  @@map("listings")
}

model Review {
  id         String   @id @default(cuid())
  listingId  String
  reviewerId String
  rating     Int      @db.SmallInt
  comment    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  reports    Report[]
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([listingId, reviewerId])
  @@index([reviewerId], map: "reviews_reviewerId_fkey")
  @@map("reviews")
}

model Booking {
  id              String          @id @default(cuid())
  listingId       String
  userId          String
  startDate       DateTime
  endDate         DateTime
  amount          Float
  totalAmount     Float?
  currency        String          @default("BDT")
  status          BookingStatus   @default(PENDING)
  stripeSessionId String?
  createdAt       DateTime        @default(now())
  payment         BookingPayment?
  listing         Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntents  PaymentIntent[] @relation("BookingPaymentIntents")
  transactions    Transaction[]   @relation("BookingTransactions")
  monthlyPayments MonthlyPayment[] @relation("BookingMonthlyPayments")

  @@index([listingId], map: "bookings_listingId_fkey")
  @@index([userId], map: "bookings_userId_fkey")
  @@index([listingId, status, startDate, endDate], map: "bookings_conflict_check")
  @@index([status, startDate, endDate], map: "bookings_date_range")
  @@map("bookings")
}

model ChatThread {
  id            String            @id @default(cuid())
  type          ThreadType        @default(DIRECT)
  title         String?
  description   String?
  avatar        String?
  listingId     String?
  isActive      Boolean           @default(true)
  isPinned      Boolean           @default(false)
  isMuted       Boolean           @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  analytics     ChatAnalytics[]   @relation("ThreadAnalytics")
  messages      ChatMessage[]     @relation("ThreadMessages")
  participants  ChatParticipant[] @relation("ThreadParticipants")
  reports       ChatReport[]      @relation("ThreadReports")
  listing       Listing?          @relation("ThreadListing", fields: [listingId], references: [id])

  @@index([listingId], map: "chat_threads_listingId_fkey")
  @@map("chat_threads")
}

model ChatParticipant {
  id           String               @id @default(cuid())
  userId       String
  threadId     String
  role         ParticipantRole      @default(MEMBER)
  joinedAt     DateTime             @default(now())
  lastSeenAt   DateTime?
  isOnline     Boolean              @default(false)
  isMuted      Boolean              @default(false)
  isBlocked    Boolean              @default(false)
  sentMessages ChatMessage[]        @relation("ParticipantSentMessages")
  thread       ChatThread           @relation("ThreadParticipants", fields: [threadId], references: [id], onDelete: Cascade)
  user         User                 @relation("UserChatParticipants", fields: [userId], references: [id], onDelete: Cascade)
  readReceipts MessageReadReceipt[] @relation("ParticipantReadReceipts")

  @@unique([userId, threadId])
  @@index([threadId], map: "chat_participants_threadId_fkey")
  @@map("chat_participants")
}

model ChatMessage {
  id           String               @id @default(cuid())
  threadId     String
  senderId     String
  content      String
  type         MessageType          @default(TEXT)
  status       MessageStatus        @default(SENT)
  metadata     Json?
  replyToId    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deliveredAt  DateTime?
  readAt       DateTime?
  editedAt     DateTime?
  replyTo      ChatMessage?         @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      ChatMessage[]        @relation("MessageReplies")
  sender       ChatParticipant      @relation("ParticipantSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  thread       ChatThread           @relation("ThreadMessages", fields: [threadId], references: [id], onDelete: Cascade)
  reports      ChatReport[]         @relation("MessageReports")
  attachments  MessageAttachment[]  @relation("MessageAttachments")
  readReceipts MessageReadReceipt[] @relation("MessageReadReceipts")

  @@index([replyToId], map: "chat_messages_replyToId_fkey")
  @@index([senderId], map: "chat_messages_senderId_fkey")
  @@index([threadId], map: "chat_messages_threadId_fkey")
  @@map("chat_messages")
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  listingId  String?
  reviewId   String?
  targetType String
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  review     Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([listingId], map: "reports_listingId_fkey")
  @@index([reporterId], map: "reports_reporterId_fkey")
  @@index([reviewId], map: "reports_reviewId_fkey")
  @@map("reports")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetId   String?
  targetType String?
  details    String?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "admin_logs_adminId_fkey")
  @@map("admin_logs")
}

model BookingPayment {
  id                  String      @id @default(cuid())
  bookingId           String      @unique
  userId              String
  listingId           String
  amount              Float
  currency            String      @default("BDT")
  status              String      @default("PENDING")
  paymentMethod       String?
  transactionId       String?
  bankTransactionId   String?
  sslTransactionId    String?
  sessionkey          String?
  cardType            String?
  cardNo              String?
  cardIssuer          String?
  paymentAt           DateTime?
  failedReason        String?
  refundAmount        Float?      @default(0)
  refundedAt          DateTime?
  refundTransactionId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  booking             Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing             Listing     @relation("ListingPayments", fields: [listingId], references: [id], onDelete: Cascade)
  user                User        @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  refunds             RefundLog[]

  @@index([listingId], map: "booking_payments_listingId_fkey")
  @@index([userId], map: "booking_payments_userId_fkey")
  @@map("booking_payments")
}

model MonthlyPayment {
  id            String   @id @default(cuid())
  bookingId     String
  userId        String
  listingId     String
  type          String   @default("MONTHLY") // UPFRONT or MONTHLY
  amount        Float
  currency      String   @default("BDT")
  status        String   @default("PENDING") // PENDING, PAID, OVERDUE, PENDING_CONFIRMATION
  paymentMethod String?
  transactionId String?
  dueDate       DateTime
  periodStart   DateTime
  periodEnd     DateTime
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking  @relation("BookingMonthlyPayments", fields: [bookingId], references: [id], onDelete: Cascade)
  listing       Listing  @relation("ListingMonthlyPayments", fields: [listingId], references: [id], onDelete: Cascade)
  user          User     @relation("UserMonthlyPayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "monthly_payments_bookingId_fkey")
  @@index([userId], map: "monthly_payments_userId_fkey")
  @@index([listingId], map: "monthly_payments_listingId_fkey")
  @@unique([bookingId, dueDate])
  @@map("monthly_payments")
}

model RefundLog {
  id            String         @id @default(cuid())
  paymentId     String
  amount        Float
  reason        String
  requestedBy   String
  processedBy   String
  transactionId String?
  status        String         @default("PENDING")
  failureReason String?
  createdAt     DateTime       @default(now())
  payment       BookingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId], map: "refund_logs_paymentId_fkey")
  @@map("refund_logs")
}

model NotificationModel {
  id         String                 @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  data       Json?
  isRead     Boolean                @default(false)
  priority   String
  category   String
  actionUrl  String?
  expiresAt  DateTime?
  createdAt  DateTime               @default(now())
  readAt     DateTime?
  deliveries NotificationDelivery[]
  user       User                   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model NotificationPreferences {
  userId               String   @id
  emailEnabled         Boolean  @default(true)
  emailBookings        Boolean  @default(true)
  emailListings        Boolean  @default(true)
  emailMessages        Boolean  @default(false)
  emailRecommendations Boolean  @default(true)
  emailMarketing       Boolean  @default(false)
  emailSecurity        Boolean  @default(true)
  pushEnabled          Boolean  @default(true)
  pushBookings         Boolean  @default(true)
  pushListings         Boolean  @default(true)
  pushMessages         Boolean  @default(true)
  pushRecommendations  Boolean  @default(false)
  pushMarketing        Boolean  @default(false)
  inAppEnabled         Boolean  @default(true)
  inAppBookings        Boolean  @default(true)
  inAppListings        Boolean  @default(true)
  inAppMessages        Boolean  @default(true)
  inAppRecommendations Boolean  @default(true)
  inAppMarketing       Boolean  @default(false)
  smsEnabled           Boolean  @default(false)
  smsBookings          Boolean  @default(false)
  smsEmergency         Boolean  @default(true)
  quietHoursEnabled    Boolean  @default(false)
  quietHoursStart      String   @default("22:00")
  quietHoursEnd        String   @default("08:00")
  timezone             String   @default("Asia/Dhaka")
  digestEnabled        Boolean  @default(false)
  digestFrequency      String   @default("WEEKLY")
  updatedAt            DateTime @default(now()) @updatedAt
  user                 User     @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String            @id @default(cuid())
  notificationId String
  channel        String
  status         String            @default("PENDING")
  provider       String?
  externalId     String?
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  notification   NotificationModel @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId], map: "notification_deliveries_notificationId_fkey")
  @@map("notification_deliveries")
}

model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
  user      User      @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "push_subscriptions_userId_fkey")
  @@map("push_subscriptions")
}

model SavedSearch {
  id           String    @id @default(cuid())
  userId       String
  name         String
  filters      String
  alertEnabled Boolean   @default(true)
  lastNotified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("UserSavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "saved_searches_userId_fkey")
  @@map("saved_searches")
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation("ListingFavorites", fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId], map: "user_favorites_userId_fkey")
  @@index([listingId], map: "user_favorites_listingId_fkey")
  @@map("user_favorites")
}

model SearchAnalytics {
  id              String   @id @default(cuid())
  searchId        String   @unique
  userId          String?
  query           String
  filters         String
  resultCount     Int
  clickedListings Json
  searchTime      Int
  userAgent       String?
  ipAddress       String?
  sessionId       String?
  timestamp       DateTime @default(now())
  user            User?    @relation("UserSearchAnalytics", fields: [userId], references: [id])

  @@index([userId], map: "search_analytics_userId_fkey")
  @@map("search_analytics")
}

model MessageReadReceipt {
  id            String          @id @default(cuid())
  messageId     String
  participantId String
  readAt        DateTime        @default(now())
  message       ChatMessage     @relation("MessageReadReceipts", fields: [messageId], references: [id], onDelete: Cascade)
  participant   ChatParticipant @relation("ParticipantReadReceipts", fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@index([participantId], map: "message_read_receipts_participantId_fkey")
  @@map("message_read_receipts")
}

model MessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  thumbnailUrl String?
  message      ChatMessage @relation("MessageAttachments", fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_attachments_messageId_fkey")
  @@map("message_attachments")
}

model ChatSettings {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  enablePushNotifications     Boolean  @default(true)
  enableEmailNotifications    Boolean  @default(true)
  enableSoundNotifications    Boolean  @default(true)
  allowMessagesFromStrangers  Boolean  @default(true)
  showOnlineStatus            Boolean  @default(true)
  showReadReceipts            Boolean  @default(true)
  showTypingIndicators        Boolean  @default(true)
  theme                       String   @default("auto")
  fontSize                    String   @default("medium")
  compactMode                 Boolean  @default(false)
  autoArchiveAfterDays        Int?
  autoDeleteMessagesAfterDays Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation("UserChatSettings", fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_settings")
}

model BlockedUser {
  id            String   @id @default(cuid())
  userId        String
  blockedUserId String
  reason        String?
  blockedAt     DateTime @default(now())
  blockedUser   User     @relation("UserBlockedBy", fields: [blockedUserId], references: [id], onDelete: Cascade)
  user          User     @relation("UserBlocked", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([blockedUserId], map: "blocked_users_blockedUserId_fkey")
  @@map("blocked_users")
}

model ChatReport {
  id          String       @id @default(cuid())
  reporterId  String
  threadId    String
  messageId   String?
  reason      String
  description String
  status      String       @default("PENDING")
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime     @default(now())
  message     ChatMessage? @relation("MessageReports", fields: [messageId], references: [id], onDelete: Cascade)
  reporter    User         @relation("UserChatReports", fields: [reporterId], references: [id], onDelete: Cascade)
  thread      ChatThread   @relation("ThreadReports", fields: [threadId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "chat_reports_messageId_fkey")
  @@index([reporterId], map: "chat_reports_reporterId_fkey")
  @@index([threadId], map: "chat_reports_threadId_fkey")
  @@map("chat_reports")
}

model ChatAnalytics {
  id                  String     @id @default(cuid())
  userId              String
  threadId            String
  messagesSent        Int        @default(0)
  messagesReceived    Int        @default(0)
  averageResponseTime Float      @default(0)
  totalChatTime       Float      @default(0)
  lastActivityAt      DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  thread              ChatThread @relation("ThreadAnalytics", fields: [threadId], references: [id], onDelete: Cascade)
  user                User       @relation("UserChatAnalytics", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId], map: "chat_analytics_threadId_fkey")
  @@map("chat_analytics")
}

model PaymentMethod {
  id               String            @id @default(cuid())
  userId           String
  type             PaymentMethodType
  provider         PaymentProvider
  providerMethodId String
  cardLast4        String?
  cardBrand        String?
  cardExpMonth     Int?
  cardExpYear      Int?
  cardCountry      String?
  bankName         String?
  bankLast4        String?
  bankAccountType  String?
  walletType       String?
  isDefault        Boolean           @default(false)
  isVerified       Boolean           @default(false)
  nickname         String?
  billingAddress   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  paymentIntents   PaymentIntent[]   @relation("PaymentMethodIntents")
  user             User              @relation("UserPaymentMethods", fields: [userId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]    @relation("SubscriptionPaymentMethods")
  transactions     Transaction[]     @relation("PaymentMethodTransactions")

  @@index([userId], map: "payment_methods_userId_fkey")
  @@map("payment_methods")
}

model PaymentIntent {
  id               String          @id @default(cuid())
  userId           String
  amount           Int
  currency         Currency
  status           PaymentStatus
  provider         PaymentProvider
  providerIntentId String
  paymentMethodId  String?
  subscriptionId   String?
  listingId        String?
  bookingId        String?
  description      String?
  receiptEmail     String?
  metadata         Json?
  clientSecret     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  confirmedAt      DateTime?
  canceledAt       DateTime?
  booking          Booking?        @relation("BookingPaymentIntents", fields: [bookingId], references: [id])
  listing          Listing?        @relation("ListingPaymentIntents", fields: [listingId], references: [id])
  paymentMethod    PaymentMethod?  @relation("PaymentMethodIntents", fields: [paymentMethodId], references: [id])
  subscription     Subscription?   @relation("SubscriptionPaymentIntents", fields: [subscriptionId], references: [id])
  user             User            @relation("UserPaymentIntents", fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]   @relation("PaymentIntentTransactions")

  @@index([bookingId], map: "payment_intents_bookingId_fkey")
  @@index([listingId], map: "payment_intents_listingId_fkey")
  @@index([paymentMethodId], map: "payment_intents_paymentMethodId_fkey")
  @@index([subscriptionId], map: "payment_intents_subscriptionId_fkey")
  @@index([userId], map: "payment_intents_userId_fkey")
  @@map("payment_intents")
}

model Transaction {
  id                    String          @id @default(cuid())
  userId                String
  type                  TransactionType
  status                PaymentStatus
  amount                Int
  currency              Currency
  paymentIntentId       String?
  paymentMethodId       String?
  subscriptionId        String?
  listingId             String?
  bookingId             String?
  refundId              String?
  description           String
  metadata              Json?
  provider              PaymentProvider
  providerTransactionId String?
  providerFee           Int?
  grossAmount           Int
  feeAmount             Int
  netAmount             Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  processedAt           DateTime?
  booking               Booking?        @relation("BookingTransactions", fields: [bookingId], references: [id])
  listing               Listing?        @relation("ListingTransactions", fields: [listingId], references: [id])
  paymentIntent         PaymentIntent?  @relation("PaymentIntentTransactions", fields: [paymentIntentId], references: [id])
  paymentMethod         PaymentMethod?  @relation("PaymentMethodTransactions", fields: [paymentMethodId], references: [id])
  subscription          Subscription?   @relation("SubscriptionTransactions", fields: [subscriptionId], references: [id])
  user                  User            @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "transactions_bookingId_fkey")
  @@index([listingId], map: "transactions_listingId_fkey")
  @@index([paymentIntentId], map: "transactions_paymentIntentId_fkey")
  @@index([paymentMethodId], map: "transactions_paymentMethodId_fkey")
  @@index([subscriptionId], map: "transactions_subscriptionId_fkey")
  @@index([userId], map: "transactions_userId_fkey")
  @@map("transactions")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  plan                   SubscriptionPlan
  status                 SubscriptionStatus
  provider               PaymentProvider
  providerSubscriptionId String
  providerCustomerId     String
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  billingCycleAnchor     DateTime?
  defaultPaymentMethodId String?
  currency               Currency
  unitAmount             Int
  quantity               Int                @default(1)
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  cancellationReason     String?
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  invoices               Invoice[]          @relation("SubscriptionInvoices")
  paymentIntents         PaymentIntent[]    @relation("SubscriptionPaymentIntents")
  defaultPaymentMethod   PaymentMethod?     @relation("SubscriptionPaymentMethods", fields: [defaultPaymentMethodId], references: [id])
  user                   User               @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]      @relation("SubscriptionTransactions")

  @@index([defaultPaymentMethodId], map: "subscriptions_defaultPaymentMethodId_fkey")
  @@index([userId], map: "subscriptions_userId_fkey")
  @@map("subscriptions")
}

model Invoice {
  id                 String          @id @default(cuid())
  userId             String
  subscriptionId     String?
  status             InvoiceStatus
  provider           PaymentProvider
  providerInvoiceId  String
  invoiceNumber      String
  description        String?
  currency           Currency
  subtotal           Int
  taxAmount          Int             @default(0)
  discountAmount     Int             @default(0)
  total              Int
  amountPaid         Int             @default(0)
  amountDue          Int
  periodStart        DateTime
  periodEnd          DateTime
  dueDate            DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  attemptCount       Int             @default(0)
  nextPaymentAttempt DateTime?
  items              Json
  invoicePdf         String?
  receiptNumber      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  subscription       Subscription?   @relation("SubscriptionInvoices", fields: [subscriptionId], references: [id])
  user               User            @relation("UserInvoices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId], map: "invoices_subscriptionId_fkey")
  @@index([userId], map: "invoices_userId_fkey")
  @@map("invoices")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  category  String
  message   String   @db.Text
  status    String   @default("PENDING")
  response  String?  @db.Text
  respondedAt DateTime?
  respondedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

model TenantRequest {
  id              String   @id @default(cuid())
  bachelorId      String
  landlordId      String
  listingId       String
  message         String   @db.Text
  moveInDate      DateTime
  duration        String   // e.g., "6_MONTHS", "1_YEAR", "FLEXIBLE"
  budget          Float
  profession      String?
  company         String?
  monthlyIncome   Float?
  references      Json?    // Array of references
  documents       Json?    // Array of document URLs
  emergencyContact Json?   // Emergency contact info
  status          TenantRequestStatus @default(PENDING)
  landlordResponse String? @db.Text
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  bachelor        User     @relation("BachelorRequests", fields: [bachelorId], references: [id], onDelete: Cascade)
  landlord        User     @relation("LandlordRequests", fields: [landlordId], references: [id], onDelete: Cascade) 
  listing         Listing  @relation("ListingRequests", fields: [listingId], references: [id], onDelete: Cascade)

  @@index([bachelorId], map: "tenant_requests_bachelorId_fkey")
  @@index([landlordId], map: "tenant_requests_landlordId_fkey")
  @@index([listingId], map: "tenant_requests_listingId_fkey")
  @@map("tenant_requests")
}

model WebhookEvent {
  id          String          @id @default(cuid())
  type        String
  provider    PaymentProvider
  data        Json
  processed   Boolean         @default(false)
  error       String?
  attempts    Int             @default(0)
  maxAttempts Int             @default(3)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("webhook_events")
}

model UserAnalytics {
  id               String     @id @default(cuid())
  userId           String?
  sessionId        String
  userAgent        String
  ipAddress        String?
  country          String?
  city             String?
  device           DeviceType
  browser          String
  referrer         String?
  landingPage      String
  sessionDuration  Int        @default(0)
  pageViews        Int        @default(0)
  actionsPerformed Json
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User?      @relation("UserAnalyticsData", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("user_analytics")
}

model UserAction {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String
  type      ActionType
  target    String
  metadata  Json?
  page      String
  duration  Int?
  timestamp DateTime   @default(now())
  user      User?      @relation("UserActionHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([timestamp])
  @@map("user_actions")
}

model ListingAnalytics {
  id                  String   @id @default(cuid())
  listingId           String   @unique
  views               Int      @default(0)
  uniqueViews         Int      @default(0)
  inquiries           Int      @default(0)
  bookings            Int      @default(0)
  conversionRate      Float    @default(0)
  averageViewDuration Int      @default(0)
  impressions         Int      @default(0)
  clickThroughRate    Float    @default(0)
  favoriteCount       Int      @default(0)
  shareCount          Int      @default(0)
  contactAttempts     Int      @default(0)
  photoViews          Json
  searchRankings      Json
  geographicViews     Json
  timeBasedViews      Json
  competitorAnalysis  Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
