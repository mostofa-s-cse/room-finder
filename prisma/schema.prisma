  @@index([listingId])
  @@index([views])
  @@index([conversionRate])
  @@map("listing_analytics")
}

model PaymentAnalytics {
  id                        String   @id @default(cuid())
  period                    String   @unique
  totalRevenue              Float    @default(0)
  transactionCount          Int      @default(0)
  averageTransactionValue   Float    @default(0)
  successRate               Float    @default(0)
  failureRate               Float    @default(0)
  refundRate                Float    @default(0)
  processingFees            Float    @default(0)
  netRevenue                Float    @default(0)
  paymentMethodDistribution Json
  monthlyRevenue            Json
  geographicRevenue         Json
  userTypeRevenue           Json
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([period])
  @@index([totalRevenue])
