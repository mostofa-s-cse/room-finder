  growthRate        Float          @default(0)
  trendingDirection TrendDirection @default(STABLE)
  demographics      Json
  marketInsights    Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([city])
  @@index([area])
  @@index([demandLevel])
  @@index([averagePrice])
  @@map("geographic_analytics")
}

model AdminAnalytics {
  id                        String   @id @default(cuid())
  period                    String   @unique
  totalUsers                Int      @default(0)
  activeUsers               Int      @default(0)
  newUsersToday             Int      @default(0)
  newUsersThisMonth         Int      @default(0)
  totalListings             Int      @default(0)
  activeListings            Int      @default(0)
