  @@unique([landlordId, period])
  @@index([landlordId])
  @@index([period])
  @@index([conversionRate])
  @@index([totalRevenue])
  @@map("landlord_analytics")
}

model AnalyticsInsight {
  id             String    @id @default(cuid())
  type           String
  category       String
  title          String
  description    String
  confidence     Float     @default(0)
  impact         String
  actionable     Boolean   @default(false)
  recommendation String?
  relatedMetrics Json
  userId         String?
  listingId      String?
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  listing        Listing?  @relation("ListingInsights", fields: [listingId], references: [id], onDelete: Cascade)
  user           User?     @relation("UserInsights", fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([category])
  @@index([impact])
  @@index([createdAt])
  @@index([userId])
  @@index([listingId])
  @@map("analytics_insights")
}

model AnalyticsAlert {
  id             String    @id @default(cuid())
  type           String
  severity       String
  title          String
  description    String
  metric         String
  threshold      Float
  actualValue    Float
  userId         String?
  listingId      String?
  acknowledged   Boolean   @default(false)
  resolved       Boolean   @default(false)
  acknowledgedBy String?
  resolvedBy     String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  listing        Listing?  @relation("ListingAlerts", fields: [listingId], references: [id], onDelete: Cascade)
  user           User?     @relation("UserAlerts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([severity])
  @@index([acknowledged])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
  @@index([listingId])
  @@map("analytics_alerts")
}

